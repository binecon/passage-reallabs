---
const { lab } = Astro.props;

const fields: string[] = lab.data.fields;
---
<article class="card" style={`--lab-color:${lab.data.color}`}>

  <div class="card-content">

    <h3 class="title">
      {lab.data.title}
    </h3>


    <div class="details">

      <div class="fields">
        {lab.data.fields.map((field: string) => (
          <span>{field}</span>
        ))}
      </div>


      <div class="detail">
        <span class="label">Datum</span>
        <span>{lab.data.date}</span>
      </div>


      <div class="detail">
        <span class="label">Partner</span>
        <span>{lab.data.partner}</span>
      </div>

    </div>

  </div>


  <div class="card-footer">
    <a href={`/reallabs/${lab.id}/`} class="button">
      Case Study ansehen →
    </a>

  </div>

</article>



<style>

.card {
  border-radius:20px;
  overflow:hidden;
  display:flex;
  flex-direction:column;
  height:380px;

  background: linear-gradient(
    to bottom,
    var(--bg) 0%,
    #FFFFFF 100%
  );
}

/* upper white area */

.card-content {
  padding: 1.8rem 1.8rem 0.2rem;
  flex:1;
}

.title {
  margin:0 0 1.2rem;
  color:var(--lab-color);
  font-size:1.8rem;
  font-weight:700;
  line-height:1.1;
}


/* details */

.details {
  padding:0;
}

.fields {
  font-size:.9rem;
  line-height:1.5;
  margin-bottom:2rem;
}
.fields span:not(:last-child)::after {
  content:", ";
}

.detail {
  margin-top:1rem;
}

.label {
  display:block;
  font-size:.7rem;
  text-transform:uppercase;
  letter-spacing:.08em;
  margin-bottom:.25rem;
  color: var(--grey)
}

.detail span:not(.label) {
  font-size:.9rem;
  margin-bottom:2rem;
}


/* lower coloured CTA area */

.card-footer {
  min-height: 80px;
  display: flex;
  justify-content: center;
  align-items: center;
  background: var(--lab-color);
  padding: 0;
}

</style>