---
const { lab } = Astro.props;

const fields: string[] = lab.data.fields;
---

<article class="card">

  <a href={`/reallabs/${lab.id}`}>

    <div class="card-header">
      <h3>{lab.data.title}</h3>
      <p class="subtitle">
        {lab.data.subtitle}
      </p>
    </div>


    <div class="card-body">

      <p class="partner">
        <strong>Partner</strong><br />
        {lab.data.partner}
      </p>


      <div class="meta">

        <div>
          <strong>Ort</strong>
          <br />
          {lab.data.location}
        </div>

        <div>
          <strong>Datum</strong>
          <br />
          {lab.data.date}
        </div>

      </div>


      <div class="fields">
        {fields.map((field) => (
          <span>{field}</span>
        ))}
      </div>

    </div>


    <div class="cta">
      Case Study ansehen →
    </div>


  </a>

</article>


<style>
.card {
  border: 1px solid #ddd;
  border-radius: 16px;
  padding: 1.5rem;

  display: flex;
  flex-direction: column;

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 24px rgba(0,0,0,0.08);
}

.card a {
  text-decoration: none;
  color: inherit;
}


h3 {
  margin-top: 0;
  margin-bottom: 0.5rem;
}


.subtitle {
  margin-top: 0;
  opacity: 0.75;
}


.partner {
  margin-top: 1.5rem;
}


.meta {
  display: flex;
  gap: 2rem;
  margin-top: 1.5rem;

  font-size: 0.9rem;
}


.fields {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-top: 1.5rem;
}


.fields span {
  border: 1px solid #ccc;
  border-radius: 999px;

  padding: 0.25rem 0.75rem;

  font-size: 0.85rem;
}


.cta {
  margin-top: 1.5rem;
  font-weight: 600;
}
</style>