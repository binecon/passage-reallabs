---
const { lab } = Astro.props;

const fields: string[] = lab.data.fields;
---

<article
  class="card"
  style={`--lab-color: ${lab.data.color};`}
>

  <a href={`/reallabs/${lab.id}`}>

    <div class="card-header">
      <h3>{lab.data.title}</h3>
      <p class="subtitle">
        {lab.data.subtitle}
      </p>
    </div>


    <div class="card-body">

      <p class="partner">
        <strong>Partner</strong><br />
        {lab.data.partner}
      </p>


      <div class="meta">

        <div>
          <strong>Ort</strong>
          <br />
          {lab.data.location}
        </div>

        <div>
          <strong>Datum</strong>
          <br />
          {lab.data.date}
        </div>

      </div>


      <div class="fields">
        {lab.data.fields.map((field: string) => (
        <span>{field}</span>
        ))}
      </div>

    </div>


    <div class="cta-container">
      <a class="cta" href={lab.url}>
      <span>Case Study ansehen →</span>
      </a>
  </div>

  </a>

</article>


<style>
.card {
  /* border-top: 6px solid var(--lab-color); */
  background: var(--lab-color);
  border: 5px solid var(--lab-color);
  border-radius: 10px;
  padding: 1.5rem;

  display: flex;
  flex-direction: column;

  transition:
  transform 0.2s ease,
  box-shadow 0.2s ease;
}
.card a {
  text-decoration: none;
  color: inherit;
}

.card:hover {
  box-shadow: 0 0 20px color-mix(in srgb, var(--lab-color), white 70%);
}

.title {
  font-size: 2em;
  font-weight: 700;
  line-height:1.2;
  margin:0;
}
.subtitle {
  margin-top:.5rem;
  font-size:1.05rem;
  font-weight:400;
  line-height:1.4;
  color:rgba(0,0,0,.75);
}

.meta {
  display:flex;
  gap:1rem;
  margin-top:1rem;
  font-size:.9rem;
  color:rgba(0,0,0,.65);
}
.fields {
  margin-top:1rem;
  font-size:.85rem;
  font-weight:500;
  color:rgba(0,0,0,.65);
}

.fields span {
  font-size:.9rem;
}

.fields span:not(:last-child)::after {
  content:" · ";
  margin-left:.4rem;
}
.cta-container {
  margin-top: auto;
  padding-top: 1.5rem;
}

.cta {
  border-top: 1px solid rgba(0,0,0,.15);
  padding-top: 1rem;
  font-size:1rem;
  font-weight: 700;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.cta:hover {
  letter-spacing:.02em;
}
</style>