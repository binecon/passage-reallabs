---
const { lab } = Astro.props;
---

<!-- complete lab page -->

<article
  class="card"
  style={`
    --lab-color:${lab.data.color};
    --lab-title-color:${lab.data.titleColor ?? lab.data.color};
  `}
>

<div class="card-content">

    <h3 class="title">
      {lab.data.title}
    </h3>


    <div class="fields">
      {lab.data.fields.map((field: string) => (
        <span>{field}</span>
      ))}
    </div>


    <div class="partner">

      <span class="label">
        Kooperation mit
      </span>

      <span class="partner-name">
        {lab.data.partner}
      </span>

    </div>


  </div>


<div class="card-footer">

  <a
    href={`/reallabs/${lab.id}/`}
    class="card-link"
  >
    Projekt ansehen →
  </a>

</div>

</article>


<style>

  .brand-marker {
  display:inline-flex;
  align-items:center;
  justify-content:center;

  padding:.45rem 1rem;

  border:1px solid var(--dark-grey);
  border-radius:999px;

  font-style:italic;
  font-weight:300;
  font-size:1.2rem;

  color:var(--dark-grey);
}

.hero h1 {
  margin-top:1.8rem;
}

.card {
  border:1px solid var(--grey);
  border-radius:20px;
  overflow:hidden;

  display:flex;
  flex-direction:column;

  min-height:360px;

  background:white;
}


/* content */

.card-content {
  padding:1.75rem;

  flex:1;

  background: linear-gradient(
    to bottom,
    var(--bg),
    white
  );
}


.title {
  position:relative;

  margin:0 0 1.5rem;

  padding-left:.9rem;

  color:var(--lab-title-color);

  font-size:1.7rem;
  font-weight:700;
  line-height:1.1;
}


.title::before {

  content:"";

  position:absolute;

  left:0;
  top:.1rem;
  bottom:.1rem;

  width:4px;

  border-radius:2px;

  background:var(--lab-title-color);
}


/* project topics */

.fields {

  margin-bottom:2rem;

  font-size:.95rem;
  line-height:1.5;

  color:var(--light-grey);
}


.fields span:not(:last-child)::after {
  content:" · ";
}


/* partner */

.partner {
  margin-top:auto;
}


.label {

  display:block;

  margin-bottom:.6rem;

  font-size:.8rem;

  text-transform:uppercase;

  letter-spacing:.09em;

  color:var(--light-grey);
}


.partner-name {

  font-size:1.1rem;
  line-height:1.8rem;
  font-style:oblique;

  /* font-weight:500; */

  color:var(--dark-grey);
}



/* footer */

.card-footer {

  min-height:64px;

  display:flex;

  justify-content:center;
  align-items:center;

  background: color-mix(
    in srgb,
    var(--lab-color) 75%,
    white
  );

}


</style>