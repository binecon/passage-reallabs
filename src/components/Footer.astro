      © 2026 Passage Reallabs · Smart-City-Bildungszentrum Halle (Saale)
    </p>

    <div class="footer-links">
      <a href="/kontakt">Kontakt</a>
      <a href="/impressum">Impressum</a>
      <a href="/datenschutz">Datenschutz</a>
    </div>
  </div>


  <div class="footer-funding">

        <p class="footer-label">
          Gefördert durch
        </p>

        <div class="footer-logos">
            <img src="/logos/halle.svg" alt="Stadt Halle (Saale)">
            <img src="/logos/smart-city.svg" alt="Smart City Halle">
            <img src="/logos/kfw.svg" alt="KfW">
        </div>

  </div>

<div class="footer-evaluation">

  <p class="footer-label">
    Wissenschaftlich<br>
    begleitet durch
  </p>

    <div class="footer-logos footer-logos--evaluation">
      <img src="/logos/logo-zsh-ohne-text.svg" alt="Zentrum für Sozialforschung">
