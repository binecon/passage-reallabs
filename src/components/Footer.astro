---
import "../styles/footer.css";
---

<footer class="footer">

  <!-- Main footer line -->
  <div class="footer-main">
    <p>
      © 2026 Passage Reallabs · Smart-City-Bildungszentrum Halle (Saale)
    </p>

    <div class="footer-links">
      <!-- <a href="/imprint">Kontakt</a> -->
      <!-- <a href={`${import.meta.env.BASE_URL}/imprint`}>Kontakt</a> -->
       <img
  src="/passage-reallabs/logos/smart-city.svg"
  alt="Smart City Halle"
/>
      <!-- <a href="/imprint">Impressum</a> -->
      <a href={`${import.meta.env.BASE_URL}/imprint`}>Impressum</a>
    </div>
  </div>


 <div class="footer-organisations">

  <!-- Kooperation -->
  <div class="footer-group--partners">
    <p class="footer-label">In Kooperation mit</p>

    <div class="footer-logos">
      <!-- <a href="https://www.smartes.halle.de/">
        <img src="/logos/smartcity.svg" alt="Smart City Halle">
      </a> -->
      <img src={`${import.meta.env.BASE_URL}/logos/smart-city.svg`} alt="Smart City Halle" />
      <!-- <a href="/">
        <img src="/logos/halle.svg" alt="Stadt Halle (Saale)">
      </a> -->
      <img src={`${import.meta.env.BASE_URL}/logos/halle.svg`} alt="Stadt Halle Saale" />

    </div>
  </div>


  <!-- Wissenschaftliche Begleitung -->
  <div class="footer-group--evaluation">
    <p class="footer-label">Wissenschaftliche Begleitung</p>

    <div class="footer-logos">
      <a href="https://www.zsh-online.de"> 
        <!-- <img src="/logos/logo-zsh-ohne-text.svg" alt="Zentrum für Sozialforschung"> -->
        <img src={`${import.meta.env.BASE_URL}/logos/logo-zhs-ohne-text.svg`} alt="Zentrum für Sozialforschung" />

      </a>
      <a href="https://www.muse.iao.fraunhofer.de"> 
        <!-- <img src="/logos/fraunhofer.svg" alt="Fraunhofer Institut"> -->
        <img src={`${import.meta.env.BASE_URL}/logos/fraunhofer.svg`} alt="Fraunhofer Institut" />

      </a>
    </div>
  </div>


  <!-- Förderung -->
  <div class="footer-group--funding">
    <p class="footer-label">Gefördert durch</p>

    <div class="footer-logos">
        <img src={`${import.meta.env.BASE_URL}/logos/hfw2.svg`} alt="BMWSB und KfW" />
        <!-- <img src="/logos/kfw2.svg" alt="BMWSB und KfW"> -->
      <!-- </a> -->
    </div>
  </div>

</div>

</footer>