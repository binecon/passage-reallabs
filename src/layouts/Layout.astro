---
import "../styles/global.css";
import '../styles/index.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/images/fav.svg`}  />
    <meta name="generator" content={Astro.generator} />
    <title>Passage Reallabs</title>
  </head>

  <body id="top">
    <slot />

    <a href="#top" class="scroll-top" aria-label="Nach oben">↑</a>

    <script>
      const scrollTop = document.querySelector('.scroll-top');

      const updateScrollTop = () => {
        if (scrollTop) {
          scrollTop.classList.toggle('is-visible', window.scrollY > 900);
        }
      };

      window.addEventListener('scroll', updateScrollTop);
      updateScrollTop();
    </script>
  </body>
</html>

