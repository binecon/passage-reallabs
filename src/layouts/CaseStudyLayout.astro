---
import { getCollection } from "astro:content";
import Layout from '../layouts/Layout.astro';
import "../styles/case-study.css";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";

const { lab } = Astro.props;
const { data } = lab;

const allLabs = await getCollection("reallabs");

const otherLabs = allLabs
  .filter((item) => item.id !== lab.id)
  .sort((a, b) => a.data.order - b.data.order);
---


<Layout>
  <div class="page case-study" style={`--lab-color:${lab.data.color};`}>

            <header>
            <PageHero
              title={lab.data.title}
              subtitle={lab.data.subtitle}
              color={lab.data.color}
            >


              <div class="lab-meta">


                <div class="meta-block">

                  <h3>
                    Praxispartner
                  </h3>

                  <p>
                    {lab.data.partner}
                  </p>

                </div>



                <div class="meta-block">

                  <h3>
                    Durchführung
                  </h3>

                  <p>
                    {lab.data.date} · {lab.data.location}
                  </p>

                </div>


                <div class="meta-block">

                  <h3>
                    Teilnehmende
                  </h3>

                  <p>
                    {lab.data.participants.join(" · ")}
                  </p>

                </div>


                <div class="meta-block">

                  <h3>
                    Erprobte Kompetenzen
                  </h3>

                  <p>
                    {lab.data.comps?.join(" · ")}
                  </p>

                </div>


              </div>
          
              <div slot="visual" class="page-hero-visual">
                <div class="lab-shape">
                  <!-- <img src={`/symbols/${data.symbol}`} alt="lab symbol in lab colour" /> -->
                    <img src={`${import.meta.env.BASE_URL}/symbols/${data.symbol}`} alt="lab symbol in lab colour" />
                </div>
              </div>

            </PageHero>

            </header>

          <main>

            <article class="content">

              <slot />

            </article>

                <section class="lab-gallery">
                    <img
                      src={`${import.meta.env.BASE_URL}/images/urbanlab-team.webp`}
                      alt="Reallab Projekttag im HTZ"
                      loading="lazy"
                      
                    />
             
                </section>


            <section class="partner">


                  <h2 class="section-label">Praxispartner</h2>


                  <p class="partner-text">

                    Kooperationspartner dieses <em>Reallabs</em> ist&nbsp;
                    <strong>{lab.data.partner}</strong>.

                  </p>
              
                  <a href={`${import.meta.env.BASE_URL}/partner`} class="partner-link">
                     Eigenes Reallab entwickeln →
                  </a>

            </section>



            <section class="more-labs">


              <p class="section-label">

                <span style="font-style: oblique;">
                  Weitere Reallabs
                </span>

              </p>


              <!-- <nav class="lab-links">

                  {otherLabs.map((item) => (
                    <a href={`/reallabs/${item.id}/`}>
                      {item.data.title}
                    </a>
                  ))}

              </nav> -->
              <nav class="lab-links">
                {otherLabs.map((item) => (
                  <a href={`${import.meta.env.BASE_URL}/reallabs/${item.id}/`}>
                    {item.data.title}
                  </a>
                ))}
              </nav>

            </section>


        </main>

      <Footer />

  </div>
</Layout>