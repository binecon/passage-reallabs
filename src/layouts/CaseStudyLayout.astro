---
import { getCollection } from "astro:content";

import "../styles/global.css";
import "../styles/case-study.css";

import Footer from "../components/Footer.astro";
import BrandMarker from "../components/BrandMarker.astro";
import PageHero from "../components/PageHero.astro";

const { lab } = Astro.props;
const { data } = lab;


const allLabs = await getCollection("reallabs");

const otherLabs = allLabs
  .filter((item) => item.id !== lab.id)
  .sort((a, b) => a.data.order - b.data.order);
---

<html lang="de">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>
    {lab.data.title} · Passage Reallabs
  </title>

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>


<body class="case-study">


<div class="page" style={`--lab-color:${lab.data.color};`}>
       

      <header>
      <PageHero
        title={lab.data.title}
        subtitle={lab.data.subtitle}
        color={lab.data.color}
      >


        <div class="lab-meta">


          <div class="meta-block">

            <h4>
              Praxispartner
            </h4>

            <p>
              {lab.data.partner}
            </p>

          </div>



          <div class="meta-block">

            <h4>
              Durchführung
            </h4>

            <p>
              {lab.data.date} · {lab.data.location}
            </p>

          </div>


          <div class="meta-block">

            <h4>
              Teilnehmende
            </h4>

            <p>
              {lab.data.participants.join(" · ")}
            </p>

          </div>


          <div class="meta-block">

            <h4>
              Erprobte Kompetenzen
            </h4>

            <p>
              {lab.data.comps?.join(" · ")}
            </p>

          </div>


        </div>
     
        <div slot="visual" class="page-hero-visual">
          <div class="lab-shape">
            <img src={`/symbols/${data.symbol}`} alt="" />
          </div>
        </div>

      </PageHero>

      </header>

    <main>

      <article class="content">

        <slot />

      </article>

          <section class="lab-gallery">
              <img src={lab.data.image} alt={lab.data.alt} loading="lazy" />
          </section>


      <section class="partner">


            <p class="section-label">
              <h2>Praxispartner</h2>
            </p>


            <p class="partner-text">

              Kooperationspartner dieses Reallabs ist&nbsp;
              <strong>{lab.data.partner}</strong>.

            </p>



            <a href="/partner" class="partner-link">

              Eigenes Reallab entwickeln →

            </a>
        

      </section>



      <section class="more-labs">


        <p class="section-label">

          <span style="font-style: oblique;">
            Weitere Reallabs
          </span>

        </p>


        <nav class="lab-links">

            {otherLabs.map((item) => (
              <a href={`/reallabs/${item.id}/`}>
                {item.data.title}
              </a>
            ))}

        </nav>

      </section>


  </main>

<Footer />

</div>

</body>

</html>