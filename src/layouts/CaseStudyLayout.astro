---
import '../styles/global.css';
import '../styles/case-study.css';
import Footer from '../components/Footer.astro';
const { lab } = Astro.props;
---

<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{lab.data.title} · Passage Reallabs</title>
  </head>

  <body class="case-study">

<header class="hero" style={`--lab-color: ${lab.data.color};`}>
  <div>
    <p class="label">Passage Reallab</p>
    <h1>{lab.data.title}</h1>
    <h2>{lab.data.subtitle}</h2>
  </div>

  <!-- platzhalter home button -->

</header>


    <main>

      <section class="facts">
        <p class="section-label">
          Projektsteckbrief
        </p>

        <dl>
          <div>
            <dt>Partner</dt>
            <dd>{lab.data.partner}</dd>
          </div>

          <div>
            <dt>Datum</dt>
            <dd>{lab.data.date}</dd>
          </div>

          <div>
            <dt>Ort</dt>
            <dd>{lab.data.location}</dd>
          </div>

          <div>
            <dt>Berufsfelder</dt>
            <dd>{lab.data.fields.join(', ')}</dd>
          </div>
        </dl>
      </section>


      <article class="content">
        <slot />
      </article>


      <section class="partner-note">

          <p class="section-label">
          Praxispartner
          </p>

          <p>
          Dieses Reallab entstand gemeinsam mit
          <strong>{lab.data.partner}</strong>.
          </p>

      </section>

  </main>


    <Footer />


  </body>
</html>

