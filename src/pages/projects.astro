---
import '../styles/global.css';
import '../styles/projects.css';
import Layout from '../layouts/Layout.astro';
import PageHero from "../components/PageHero.astro";
import Footer from "../components/Footer.astro";

import { getCollection } from "astro:content";
const labs = await getCollection("reallabs");
---

<Layout>
  <main>
    <PageHero title="Alle Reallabs">
      <p>
        Wir arbeiten mit Unternehmen und Institutionen aus der Region Halle
        (Saale) zusammen. Einige Reallabs befinden sich bereits in der
        Umsetzung, weitere entstehen gemeinsam mit neuen Partnern.
      </p>
    </PageHero>

    <!-- rest of projects page -->
      
      <section class="projects-list">

       <a href={`${import.meta.env.BASE_URL}/reallabs/urbanlab/`} class="project-item" style="--lab-color:#95E5B2">
        <!-- <a href="/reallabs/urbanlab/" class="project-item" style="--lab-color:#95E5B2"> -->

          <h2>UrbanLab</h2>

          <div class="meta">
            <span>HTZ, Stadtwerke Halle (Saale)</span> · &nbsp;
            <span>September 2026</span>
          </div>

          <p><em>Sensorik · Klimaadaptive Stadtentwicklung</em></p>

        </a>

        <a href={`${import.meta.env.BASE_URL}/reallabs/smartspaces/`} class="project-item" style="--lab-color:#404ED9">
          
          <!-- <a href="/reallabs/smartspaces/" class="project-item" style="--lab-color:#404ED9"> -->
          <h2>SmartSpaces</h2>

          <div class="meta">
            <span>Regionales Logistikunternehmen · &nbsp;Oktober 2026</span>
          </div>
          <p><em>Logistik · Transport</em></p>
        </a>

        <a href={`${import.meta.env.BASE_URL}/reallabs/medicallab/`} class="project-item" style="--lab-color:#E393E9">

           <!-- <a href="/reallabs/medicallab/" class="project-item" style="--lab-color:#E393E9">     -->
          <h2>MedicalLab</h2>

          <div class="meta">
            <span>Regionales Gesundheitszentrum · &nbsp;November 2026</span>
          </div>
          <p><em>Medizintechnik · Pflegeinnovation</em></p>
      
        </a>


        <article class="project-item" style="--lab-color:#EED55C">

          <h2>ImmoLab</h2>

          <div class="meta">
            <span>Regionales Immobilienunternehmen ·&nbsp;März 2027</span>
          </div>
          <p><em>Gebäudetechnik · Nachhaltiges Bauen · Umweltsicherheit</em></p>
        
        </article>


        <article class="project-item project-item--placeholder">

          <h2>Ihr Reallab?</h2>

          <div class="meta">
            <span><strong><em>Partner gesucht</em></strong></span>
          </div>

          <p>
            Gemeinsam entwickeln wir ein <span style="font-style:oblique">Reallab</span>
            &nbsp;passend zu Ihrem Unternehmen und Ihren Themen
          </p>

          <a href={`${import.meta.env.BASE_URL}/partner`} class="partner-link">
          <!-- <a href="/partner" class="partner-link"> -->
             Eigenes Reallab entwickeln</a>→

        </article>


      </section>
   
    </main>

    <Footer />
</Layout>