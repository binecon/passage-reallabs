---
import { getCollection } from 'astro:content';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import Footer from '../components/Footer.astro';
import '../styles/index.css';
const labs = (await getCollection('reallabs'))
  .sort((a, b) => a.data.order - b.data.order);
---

<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Passage Reallabs</title>
  </head>

  <body>

  <!-- I. Hero & II. description -->
    <header class="hero">

      <div class="hero-text">

        <p class="title-logo">Logo / Wortmarke</p>

        <h2>Reale Aufgaben. Neue Perspektiven. Potenzielle Fachkräfte.</h2>
        
        <p>
         In unseren eintägigen Reallabs arbeiten Schülerinnen und Schüler gemeinsam 
         mit Unternehmen an echten Herausforderungen. Wir übernehmen Planung und Durchführung
        – Sie bringen Ihre Praxisfrage mit.
        </p>

      </div>

      <!-- <img
        src="/reallabs-logo.svg"
        alt="Passage Reallabs"
        class="logo"
      /> -->

    </header>

  <main>
<!-- III. Case Studies -->
  <section class="section">
  <p class="section-label">Projekte</p>

        <div class="cards">
         {labs.map((lab) => (
          <CaseStudyCard lab={lab} />
        ))}
        </div>
      </section>


 <!-- IV. How it works -->
  <section class="section process">

    <div class="section-header">
      <p class="section-label">Ablauf eines Reallabs</p>

      <p class="section-intro">
       Vom Projekttag zur Zusammenarbeit - in vier Schritten.
      </p>
    </div>


    <div class="process-grid">

      <article class="step">
        <div class="step-number">1</div>

        <h3>Fragestellung</h3>

        <p>
          Sie bringen eine reale Aufgabe oder Fragestellung aus Ihrem Arbeitsalltag mit
        </p>
      </article>


      <article class="step">
        <div class="step-number">2</div>

        <h3>Projekttag</h3>

        <p>
          Wir übernehmen Planung, Moderation, Material und die Zusammenarbeit mit der Schulklasse
          <!-- Beim Projekttag entwickeln Jugendliche Lösungen, Konzepte oder Prototypen -->
        </p>
      </article>


      <article class="step">
        <div class="step-number">3</div>

        <h3>Ergebnisse</h3>

        <p>
          Ergebnisse werden präsentiert und gemeinsam diskutiert
        </p>
      </article>


      <article class="step">
        <div class="step-number">4</div>

        <h3>Netzwerken</h3>

        <p>
          Wenn die Zusammenarbeit überzeugt, entstehen daraus Kontakte, z.B. für Praktika oder Ausbildungsplätze
        </p>
      </article>

    </div>

  </section>



<!-- V. Stimmen -->
 
    <section class="section testimonials">
      <p class="section-label">Stimmen aus der Praxis</p>
      <div class="testimonial-grid">
          <article class="testimonial">
            <p class="quote">
              Die Zusammenarbeit mit den Jugendlichen hat uns neue Perspektiven
              auf unsere Fragestellung eröffnet.
            </p>
            <p class="author">
              Name · Funktion<br>
              Organisation
            </p>
          </article>
          <article class="testimonial">
            <p class="quote">
              Das Reallab war eine spannende Möglichkeit, Nachwuchs für unsere
              Themen zu begeistern.
            </p>
            <p class="author">
              Name · Funktion<br>
              Organisation
            </p>
          </article>
        </div>
      </section>


  <!-- VI. CTA -->
    <section class="partner-cta">

  <p class="section-label">Kooperation</p>

  <h2>Bringen Sie Ihre Praxisfrage ein.</h2>

  <p class="text">
    Wir entwickeln gemeinsam mit Ihnen einen Projekttag und übernehmen
    Organisation, Moderation und Begleitung. Sie bringen Ihre fachliche
    Perspektive ein und lernen potenzielle Nachwuchskräfte kennen.
  </p>

  <a href="/kontakt" class="button button--cta">
    Reallab starten →
  </a>


  <!-- <div class="cta-benefits">
    <p>geringer organisatorischer Aufwand</p>
    <p>Planung und Durchführung durch Passage Reallabs</p>
    <p>reale Fragestellungen statt Musteraufgaben</p>
    <p>Kontakte zu potenziellen Nachwuchskräften</p>
  </div> -->

</section>

<!-- VIII. Einblicke -->

<section class="section insights">
  <div class="insights-content">
    <div class="insights-text">
      <p class="section-label">
        Einblicke
      </p>

      <h3>
        Was Jugendliche aus den Reallabs mitnehmen
      </h3>

      <p class="text">
        Ideen entwickeln, ausprobieren, mit echten Partnern arbeiten:
        In den Reallabs entdecken Jugendliche neue Perspektiven auf
        Zukunftsthemen und Berufsfelder.
      </p>

      <a href="/jugend" class="button button--insights">
        Mehr Einblicke →
      </a>

    </div>
    <div class="insights-media">
      <img 
        src="/images/reallab-preview.jpg"
        alt="Jugendlicher mit Sensorbox beim Reallab Projekttag"
      />
    </div>
  </div>
</section>

    </main>

    <Footer />
  </body>
</html>
 
