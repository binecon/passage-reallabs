---
import { getCollection } from 'astro:content';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import Footer from '../components/Footer.astro';
const labs = (await getCollection('reallabs'))
  .sort((a, b) => a.data.order - b.data.order);
---

<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Passage Reallabs</title>
  </head>

  <body>
   <header class="hero">

  <div class="hero-text">
    <h1>Passage Reallabs</h1>

    <p>
      Jugendliche bearbeiten reale Zukunftsfragen gemeinsam mit Unternehmen
      und Institutionen – kreativ, praxisnah und auf Augenhöhe.
    </p>
  </div>

  <img
    src="/reallabs-logo.svg"
    alt="Passage Reallabs"
    class="logo"
  />

</header>

    <main>
      <section>
        <h2>Case Studies</h2>

        <div class="cards">
         {labs.map((lab) => (
          <CaseStudyCard lab={lab} />
        ))}
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  body {
    font-family: system-ui, sans-serif;
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .card {
    border: 1px solid #ddd;
    border-radius: 12px;
    padding: 1.5rem;
  }

  .card a {
    text-decoration: none;
    color: inherit;
  }
.hero {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding-top: 4rem;
}

.hero-text {
  max-width: 620px;
}

.hero h1 {
  font-size: clamp(3rem, 5vw, 1.5rem);
  line-height: 1.05;
  margin: 0 0 1.5rem;
}

.hero p {
  font-size: 1.15rem;
  line-height: 1.7;
  color: #303131;
  max-width: 520px;
}

.logo {
  width: 180px;
  height: auto;
  align-self: flex-start;
}
.logo-link {
  display: inline-block;
  cursor: pointer;
}

.logo-link img {
  display: block;
}

</style>