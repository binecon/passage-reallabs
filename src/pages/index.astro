---
import { getCollection } from 'astro:content';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/index.css';
const labs = (await getCollection('reallabs'))
  .sort((a, b) => a.data.order - b.data.order);
---

<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- <link rel="icon" type="image/png" href="/favicon.png" /> -->
    <title>Passage Reallabs</title>
  </head>

  <body>

  <!-- Hero -->
<header class="hero">

  <div class="hero-copy">

      <p class="hero-brand">
        Passage Reallabs
      </p>

     <p class="hero-intro">
      Jugendliche aus Halle arbeiten an echten Fragestellungen aus Unternehmen und ihrer Stadt.
      Sie gestalten mit, probieren aus und lernen dabei Arbeitsfelder und Berufsperspektiven aus erster Hand kennen.
      Unternehmen erhalten direkten Kontakt zu Jugendlichen aus der Region und können zeigen, was ihre Arbeit und ihre Berufsfelder ausmacht.
    </p>

  </div>

  <div class="hero-visual">
      <img src="images/polygon-foto.png" alt="Passage Reallabs" class="platzhalter" />
  </div>

</header>

  
<main>
    
<!-- labs preview -->
<section class="section projects-preview">

  <p class="section-label">
    Projektbeispiel
  </p>


  <a 
    href="/reallabs/urbanlab/"
    class="project-preview-item"
    style="--lab-color:#95E5B2"
  >

 <div class="project-preview-content">
  <h2>UrbanLab</h2>
  <span class="project-fields">
    Sensorik · Klimaadaptive Stadtentwicklung
  </span>
  <p>Stadtwerke Halle (Saale)</p>
</div>

<span class="project-link">
  Projekt ansehen →
</span>

  </a>


   <div class="projects-action">
      <a href="/projects" class="button button--projects">
        Alle Reallabs →
      </a>
  </div>


</section>



 <!-- How it works -->
  <section class="section process">

    <div class="section-header">
      <p class="section-label">Ablauf eines Reallabs</p>

      <p class="process-intro text">
        Ein gemeinsamer Prozess mit Mehrwert für beide Seiten: 
        Jugendliche erleben Arbeitswelt praktisch und authentisch, Unternehmen 
        entdecken Interessen und Potenziale zukünftiger Nachwuchskräfte.      
      </p>
    </div>

    <div class="process-grid">
      <article class="step">
        <div class="step-number">1</div>
        <h3>Praxisfrage</h3>
        <p>
          Sie bringen eine reale Aufgabe oder Fragestellung aus Ihrem Arbeitsalltag mit
        </p>
      </article>

      <article class="step">
        <div class="step-number">2</div>
        <h3>Projekttag</h3>
        <p>
          Wir übernehmen Planung, Moderation, Material und die Zusammenarbeit mit den Teilnehmenden bzw. der Schulklasse
          <!-- Beim Projekttag entwickeln Jugendliche Lösungen, Konzepte oder Prototypen -->
        </p>
      </article>

      <article class="step">
        <div class="step-number">3</div>
        <h3>Ergebnisse</h3>
        <p>
          Ergebnisse werden von den jungen Teilnehmenden präsentiert und gemeinsam diskutiert
        </p>
      </article>

      <article class="step">
        <div class="step-number">4</div>
        <h3>Kontakte knüpfen</h3>
        <p>
          Wenn die Zusammenarbeit überzeugt, entstehen daraus Kontakte, z.B. für Praktika oder Ausbildungsplätze
        </p>
      </article>
    </div>
  </section>



<!-- Einblicke -->

<section class="section insights">
  <div class="insights-content">
    <div class="insights-text">
      <p class="section-label">
        Einblicke
      </p>

      <h3>
        Was Jugendliche aus den Reallabs mitnehmen
      </h3>

      <p class="text">
        Ideen entwickeln, ausprobieren, mit echten Partnern arbeiten:<br>
        In den <span style="font-style:italic">Reallabs</span> entdecken Jugendliche neue Perspektiven auf
        Zukunftsthemen und Berufsfelder, die sie wirklich interessieren.
      </p>

      <a href="/youth" class="button button--insights">
        Mehr Einblicke →
      </a>

    </div>
    <div class="insights-media">
      <img 
        src="/images/reallab-preview.jpg"
        alt="Jugendlicher mit Sensorbox beim Reallab Projekttag"
      />
    </div>
  </div>
</section>



<!-- Stimmen -->
 
    <section class="section">
      <p class="section-label">Stimmen aus der Praxis</p>
      <div class="testimonial-grid">
          <article class="testimonial">
            <p class="quote">
              Die Zusammenarbeit mit den Jugendlichen hat uns neue Perspektiven
              auf unsere Fragestellung eröffnet.
            </p>
            <p class="author">
              Name · Funktion<br>
              Organisation
            </p>
          </article>
          <article class="testimonial">
            <p class="quote">
              Das Reallab war eine spannende Möglichkeit, Nachwuchs für unsere
              Themen zu begeistern.
            </p>
            <p class="author">
              Name · Funktion<br>
              Organisation
            </p>
          </article>
        </div>
      </section>



  <!-- CTA -->
    <section class="section partner-cta">

      <p class="section-label">Kooperation</p>

      <h2>Bringen Sie Ihre Praxisfrage ein.</h2>

      <p class="text">
        Wir entwickeln auf Basis Ihrer Praxisanforderungen einen maßgeschneiderten Projekttag 
        und übernehmen Organisation, Moderation und Begleitung. Sie bringen Ihre fachliche
        Perspektive ein und lernen potenzielle Nachwuchskräfte kennen.
      </p>

      <div class="cta-action">
          <a href="/partner" class="button button--cta">
            Ihr Reallab →
          </a>
      </div>

    </section>

    </main>

    <Footer />
  </body>
</html>
 
