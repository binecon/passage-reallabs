---
import { getCollection } from 'astro:content';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import Footer from '../components/Footer.astro';
const labs = await getCollection('reallabs');
---

<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Passage Reallabs</title>
  </head>

  <body>
    <header class="hero">
      <div class="hero-text">
        <h1>Passage Reallabs</h1>

        <p>
          Jugendliche bearbeiten reale Zukunftsfragen gemeinsam mit Unternehmen
          und Institutionen.
        </p>
      </div>

      <a href="/" class="logo-link">
        <img 
          src="/reallabs-logo.svg" 
          alt="Passage Reallabs" 
          class="logo" 
        />
      </a>
    </header>

    <main>
      <section>
        <h2>Case Studies</h2>

        <div class="cards">
         {labs.map((lab) => (
          <CaseStudyCard lab={lab} />
        ))}
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  body {
    font-family: system-ui, sans-serif;
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .card {
    border: 1px solid #ddd;
    border-radius: 12px;
    padding: 1.5rem;
  }

  .card a {
    text-decoration: none;
    color: inherit;
  }
.hero {
  min-height: 280px;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.hero-text {
  margin-top: 80px;
}

.logo {
  width: 180px;
  height: auto;
}.logo-link {
  display: inline-block;
  cursor: pointer;
}

.logo-link img {
  display: block;
}

</style>