---
import '../styles/global.css';
import '../styles/partner.css';
import Layout from '../layouts/Layout.astro';
import PageHero from "../components/PageHero.astro";
import Footer from "../components/Footer.astro";
---



  <Layout>  
      <main class="partner-page partner">

        <PageHero
          title="Ihr Reallab" 
        >
          <p>
            Sie bringen eine echte Fragestellung aus Ihrem Unternehmen ein und
            wir entwickeln daraus gemeinsam einen Projekttag für Jugendliche.
          </p>

          <p>
            Das Team des Smart-City-Bildungszentrums
            <span style="font-style: oblique;">&nbsp;Passage 13</span> übernimmt
            Konzeption, Organisation und Durchführung.
          </p>

          <div slot="visual" class="page-hero-visual">
            <div class="lab-shape"></div>
          </div>

        </PageHero>


              <!-- Nutzen -->

              <section class="section partner-benefits">

                <h3>Was Sie davon haben</h3>
                  <ul class="simple-list">
                    <li>
                      Sichtbarkeit als <strong>zukunftsorientiertes Unternehmen</strong>
                    </li>
                    <li>
                      Austausch mit <strong>Jugendlichen aus der Region</strong>
                    </li>
                    <li>
                      <strong>Authentischer Dialog</strong> mit potenziellen Nachwuchskräften
                    </li>
                    <li>
                      <strong>Neue Perspektiven</strong> auf eigene Praxisfragen
                    </li>
                    <li>
                      Beitrag zu Berufsorientierung und <strong>regionaler Fachkräftesicherung</strong>
                    </li>
                  </ul>

              </section>


              <!-- Aufwand -->

              <section class="section partner-effort">
                <h3>Was Sie einbringen</h3>
                  <p class="process-intro">
                    Ein <em>Reallab</em> umfasst einen Projekttag mit Jugendlichen.
                    Dafür brauchen wir von Ihnen:
                  </p>

                  <div class="process-grid partner-process-grid">
                    <article class="step">
                      <div class="step-number">1</div>
                      <h3>Authentischer Projektort</h3>
                      <p>
                        Eine geeignete Räumlichkeit in Ihrem Unternehmen für ca. 20 Personen,
                        mit Internetzugang und Monitor
                      </p>
                    </article>

                    <article class="step">
                      <div class="step-number">2</div>
                      <h3>Praxisbegleitung</h3>
                      <p>
                        Eine Ansprechperson aus Ihrem Unternehmen, die am Projekttag dabei ist
                        und den Jugendlichen Einblicke in Ihre Arbeitswelt gibt*
                      </p>
                    </article>

                    <article class="step">
                      <div class="step-number">3</div>
                      <h3>Zeit für Austausch & Feedback</h3>
                      <p>
                        Zu den Ergebnissen am Projekttagende, gemeinsam mit den Teilnehmenden
                      </p>
                    </article>

                  </div>

                  <p class="additional">
                    *Die Vorbereitung und Durchführung übernehmen wir. Der Zeitaufwand für die Begleitung 
                    am Projekttag beläuft sich auf circa 5 Stunden. 
                    Falls nur begrenzte zeitliche Kapazitäten vorhanden sind, ist auch eine
                    Begleitung in reduziertem Umfang möglich, beispielsweise durch einen
                    Praxisauftrag zu Beginn mit einer abschließenden Ergebnisabnahme (2 x 45 Minuten).
                  </p>
                  
            </section>


            <!-- CTA -->

            <section class="partner-section">

              <h2 class="section-label">Praxispartner</h2>

              <p class="partner-text">
                Sie möchten ein <em>Reallab</em> mit uns entwickeln und eine
                konkrete Fragestellung aus Ihrer Praxis bearbeiten?
              </p> 
              <p>
                Schreiben Sie uns an:&nbsp; 
                <strong><em>reallabs<span class="email"></span></em>
                  </strong>
              </p> 

            </section>
            

            <section class="more-labs">

              <p class="section-label">
                <span style="font-style: oblique;">
                  Weitere Reallabs
                </span>
              </p>

              <nav class="lab-links">
                <a href={`${import.meta.env.BASE_URL}/reallabs/urbanlab/`}>
                  Urbanlab
                </a>
                <a href={`${import.meta.env.BASE_URL}/reallabs/medicallab/`}>
                  Medicallab
                </a>
                 <a href={`${import.meta.env.BASE_URL}/reallabs/smartspaces/`}>
                  SmartSpaces
                </a>
              </nav>

            </section>

          </main>

          <Footer />

  </Layout>