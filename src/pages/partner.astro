---
import '../styles/global.css';
import '../styles/partner.css';

import PageHero from "../components/PageHero.astro";
import Footer from "../components/Footer.astro";

---

<html lang="de">
  
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  </head>
  <body>
  
<main>
    <PageHero
          title="Reallab entwickeln"
        >
          <p class="hero-note">
            Entwickeln Sie mit uns ein Reallab und geben Sie Jugendlichen Einblicke in Ihre Arbeitswelt.
       
            <br/>
            <strong>Sie bringen Ihre Fragestellung ein – wir übernehmen Organisation, Teilnehmendenkontakt und Durchführung.
          </strong>
  
        </p>
    </PageHero>

        <section class="page-content partner-content">

              <article class="section partner-benefits">

              <h2>Ihr Nutzen</h2>
 
               <ul class="simple-list">

                  <li>Sichtbarkeit als zukunftsorientiertes Unternehmen</li> 

                  <li>Kontakt zu Jugendlichen aus der Region</li>

                  <li>Authentischer Dialog mit zukünftigen Nachwuchskräften</li>

                  <li>Bearbeitung eigener Praxisfragen</li>

                  <li>Beitrag zu Berufsorientierung und regionaler Fachkräftesicherung</li>

                </ul>

            </article>

           
          <article class="section partner-process-section">

              <h2>Von der Idee zum Reallab</h2>

              <ol class="partner-process">
                <li>
                  <strong>Fragestellung entwickeln</strong>
                  <p>
                    Gemeinsam identifizieren wir ein Thema aus Ihrer Praxis und
                    entwickeln daraus eine passende Herausforderung für Jugendliche.
                  </p>
                </li>

                <li>
                  <strong>Reallab gestalten</strong>
                  <p>
                    Wir übernehmen die Konzeption des Lernsettings, die Organisation
                    und die Kommunikation mit den Teilnehmenden.
                  </p>
                </li>

                <li>
                  <strong>Projekttag durchführen</strong>
                  <p>
                    Jugendliche arbeiten an Ihrer realen Fragestellung und entwickeln
                    eigene Ideen und Lösungsansätze.
                  </p>
                </li>

                <li>
                  <strong>Ergebnisse sichtbar machen</strong>
                  <p>
                    Gemeinsam reflektieren wir die Ergebnisse und machen die Wirkung
                    des Reallabs sichtbar.
                  </p>
                </li>
              </ol>

          </article>

          <article class="section partner-effort">

                <h2>Ihr Aufwand</h2>

                <p class="text">
                Ein Reallab umfasst einen gemeinsamen Entwicklungsprozess und einen
                Projekttag mit Jugendlichen. Die organisatorische Vorbereitung,
                Kommunikation mit den Teilnehmenden und Durchführung übernehmen wir.
                </p>

            <ul class="simple-list">

              <li>
                <strong>Authentischer Lernort</strong><br>
                Eine geeignete Räumlichkeit in Ihrem Unternehmen für ca. 20 Personen
                (mit Internetzugang und Monitor)
              </li>

              <li>
                <strong>Praxisbegleitung</strong><br>
                Eine Ansprechperson aus Ihrem Unternehmen, die den Projekttag begleitet
                und Einblicke in Ihre Arbeitswelt ermöglicht
              </li>

              <li>
                <strong>Zeit für Austausch und Feedback</strong><br>
                Ca. 5 Stunden Begleitung am Projekttag sowie Feedback zu den Ergebnissen
              </li>

            </ul>

                <p>
                Falls nur begrenzte zeitliche Kapazitäten vorhanden sind, ist auch eine
                Begleitung in reduziertem Umfang möglich – beispielsweise durch einen
                Praxisauftrag und eine abschließende Ergebnisabnahme (ca. 90 Minuten).
                </p>

            </article>

        </section>

        <section class="partner-cta">

          <h2>
            Sie haben eine Fragestellung aus Ihrer Praxis?
          </h2>

          <p>
            Lassen Sie uns gemeinsam prüfen, wie daraus ein Reallab für
            Jugendliche entstehen kann.
          </p>

          <a href="/kontakt" class="partner-link">
            Reallab gemeinsam entwickeln →
          </a>

        </section>

</main>

 <Footer />

</body>

</html>



    

     
      
